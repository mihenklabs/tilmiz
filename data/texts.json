  {"k":"a","t":"İhlâs suresi","ref":"İhlâs suresi, 1–4. ayet","v":[[1,[["قُلْ","de ki",417],["هُوَ","O",21],["ٱللَّهُ","Allah",48],["أَحَدٌ","birdir, tektir",95]]],[2,[["ٱللَّهُ","Allah",48],["ٱلصَّمَدُ","Samed’dir (her şey O’na muhtaç)",4767]]],[3,[["لَمْ","(olumsuz: -medi)",88],["يَلِدْ","doğurmadı",160],["وَلَمْ","ve (olumsuz)",88],["يُولَدْ","doğurulmadı",160]]],[4,[["وَلَمْ","ve (olumsuz)",88],["يَكُن","olmadı",416],["لَّهُۥ","O’na",-1],["كُفُوًا","denk",-1],["أَحَدٌۢ","hiç kimse",95]]]],"tr":"De ki: O Allah birdir. Allah Samed’dir; her şey O’na muhtaçtır. Doğurmamış ve doğurulmamıştır. Hiçbir şey O’na denk değildir."},
