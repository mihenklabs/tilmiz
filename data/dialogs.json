[
  ["Selamlaşma",[["السَّلَامُ عَلَيْكُمْ.","Selamünaleyküm.",["Selam size.","Esselamü aleyküm."]],["وَعَلَيْكُمُ السَّلَامُ.","Aleykümselam.",["Ve aleyküm selam.","Size de selam."]],["كَيْفَ حَالُكَ؟","Nasılsın?",["Nasılsınız?","Hâlin nasıl?"]],["بِخَيْرٍ، الْحَمْدُ لِلّٰهِ. وَأَنْتَ؟","İyiyim, elhamdülillah. Ya sen?",["İyiyim, Allah’a şükür. Ya sen?","İyiyim, çok şükür. Sen nasılsın?"]],["أَنَا بِخَيْرٍ، شُكْرًا.","Ben de iyiyim, teşekkürler.",["İyiyim, teşekkür ederim.","İyiyim, sağ ol."]]]],
  ["Tanışma",[["مَا اسْمُكَ؟","Adın ne?",["Adınız ne?","İsmin ne?"]],["اِسْمِي أَحْمَدُ، وَأَنْتَ؟","Adım Ahmed, ya sen?",["Benim adım Ahmed, ya senin?","İsmim Ahmed, ya sen?"]],["اِسْمِي يُوسُفُ.","Adım Yusuf.",["Benim adım Yusuf.","İsmim Yusuf."]],["مِنْ أَيْنَ أَنْتَ؟","Nerelisin?",["Nerelisiniz?","Sen nerelisin?"]],["أَنَا مِنْ تُرْكِيَا.","Türkiye’denim.",["Ben Türkiye’denim.","Türkiyeliyim."]],["تَشَرَّفْنَا.","Memnun oldum.",["Müşerref oldum.","Tanıştığımıza memnun oldum."]]]],
  ["Aile",[["كَمْ أَخًا عِنْدَكَ؟","Kaç erkek kardeşin var?",["Kaç tane erkek kardeşin var?","Kaç erkek kardeşiniz var?"]],["عِنْدِي أَخَوَانِ وَأُخْتٌ وَاحِدَةٌ.","İki erkek kardeşim ve bir kız kardeşim var.",["İki erkek ve bir kız kardeşim var."]],["أَيْنَ يَسْكُنُونَ؟","Nerede oturuyorlar?",["Nerede yaşıyorlar?"]],["يَسْكُنُونَ فِي إِسْطَنْبُولَ.","İstanbul’da oturuyorlar.",["İstanbul’da yaşıyorlar."]]]],
  ["Okulda",[["هَلْ عِنْدَكَ قَلَمٌ؟","Kalemin var mı?",["Sende kalem var mı?","Kaleminiz var mı?"]],["نَعَمْ، تَفَضَّلْ.","Evet, buyur.",["Evet, buyurun.","Evet, al."]],["مَتَى يَبْدَأُ الدَّرْسُ؟","Ders ne zaman başlıyor?",["Ders ne zaman başlar?"]],["يَبْدَأُ فِي السَّاعَةِ التَّاسِعَةِ.","Saat dokuzda başlıyor.",["Saat dokuzda başlar.","Dokuzda başlıyor."]],["شُكْرًا لَكَ.","Teşekkür ederim.",["Sana teşekkür ederim.","Teşekkürler.","Sağ ol."]]]],
  ["Saat kaç?",[["كَمِ السَّاعَةُ الْآنَ؟","Saat şimdi kaç?",["Şimdi saat kaç?","Saat kaç?"]],["السَّاعَةُ الثَّالِثَةُ وَالنِّصْفُ.","Saat üç buçuk.",["Saat üç otuz."]],["هَلْ تَأَخَّرْنَا؟","Geç mi kaldık?",["Geciktik mi?"]],["لَا، عِنْدَنَا وَقْتٌ.","Hayır, vaktimiz var.",["Hayır, zamanımız var."]]]],
  ["Namaz vakti",[["هَلْ صَلَّيْتَ الظُّهْرَ؟","Öğle namazını kıldın mı?",["Öğleyi kıldın mı?","Öğle namazını kıldınız mı?"]],["لَا، لَمْ أُصَلِّ بَعْدُ.","Hayır, henüz kılmadım.",["Hayır, daha kılmadım."]],["هَيَّا بِنَا نُصَلِّي مَعًا.","Haydi beraber kılalım.",["Haydi birlikte namaz kılalım.","Hadi beraber namaz kılalım."]],["إِنْ شَاءَ اللّٰهُ.","İnşallah.",["Allah dilerse.","Allah izin verirse."]]]],
  ["Yol sorma",[["مِنْ فَضْلِكَ، أَيْنَ الْمَسْجِدُ؟","Affedersin, cami nerede?",["Lütfen, cami nerede?","Affedersiniz, mescit nerede?"]],["اِذْهَبْ مُسْتَقِيمًا ثُمَّ إِلَى الْيَمِينِ.","Düz git, sonra sağa.",["Dümdüz git, sonra sağa dön.","Doğru git, sonra sağa."]],["هَلْ هُوَ بَعِيدٌ؟","Uzak mı?",["Orası uzak mı?"]],["لَا، هُوَ قَرِيبٌ جِدًّا.","Hayır, çok yakın."],["جَزَاكَ اللّٰهُ خَيْرًا.","Allah razı olsun.",["Allah seni hayırla mükâfatlandırsın.","Allah hayrını versin."]]]],
  ["Alışveriş",[["بِكَمْ هٰذَا؟","Bu kaça?",["Bu ne kadar?","Bunun fiyatı ne?"]],["بِعِشْرِينَ رِيَالًا.","Yirmi riyal.",["Yirmi riyale."]],["هٰذَا غَالٍ جِدًّا.","Bu çok pahalı."],["خُذْهُ بِخَمْسَةَ عَشَرَ.","On beşe al.",["Onu on beşe al.","On beş riyale al."]],["حَسَنًا، شُكْرًا.","Tamam, teşekkürler.",["Peki, teşekkürler.","Tamam, sağ ol."]]]],
  ["Lokantada",[["مَاذَا تُرِيدُ أَنْ تَأْكُلَ؟","Ne yemek istersin?",["Ne yemek istiyorsun?","Ne yemek istersiniz?"]],["أُرِيدُ دَجَاجًا وَأَرُزًّا.","Tavuk ve pilav istiyorum.",["Tavuk ve pirinç istiyorum.","Tavuk pilav istiyorum."]],["وَمَاذَا تَشْرَبُ؟","Ne içersin?",["Peki ne içersin?","Ne içersiniz?"]],["كُوبَ شَايٍ، مِنْ فَضْلِكَ.","Bir bardak çay, lütfen.",["Bir fincan çay, lütfen."]],["تَفَضَّلْ.","Buyurun.",["Buyur."]]]],
  ["Doktorda",[["مَاذَا بِكَ؟","Neyin var?",["Sorun ne?","Neyiniz var?"]],["عِنْدِي صُدَاعٌ.","Başım ağrıyor.",["Baş ağrım var."]],["مُنْذُ مَتَى؟","Ne zamandan beri?",["Ne zamandır?"]],["مُنْذُ أَمْسِ.","Dünden beri.",["Dünden bu yana."]],["خُذْ هٰذَا الدَّوَاءَ، شَفَاكَ اللّٰهُ.","Bu ilacı al, Allah şifa versin.",["Bu ilacı al, Allah sana şifa versin.","Bu ilacı alın, Allah şifa versin."]]]],
  ["Telefonda",[["أَلُو، مَنْ يَتَكَلَّمُ؟","Alo, kim konuşuyor?",["Alo, kiminle görüşüyorum?","Alo, kimsiniz?"]],["أَنَا خَالِدٌ. هَلْ مُحَمَّدٌ مَوْجُودٌ؟","Ben Halid. Muhammed orada mı?",["Ben Halid. Muhammed evde mi?","Ben Halid. Muhammed var mı?"]],["لَا، هُوَ لَيْسَ هُنَا الْآنَ.","Hayır, şu an burada değil.",["Hayır, o şu anda burada değil."]],["سَأَتَّصِلُ لَاحِقًا. مَعَ السَّلَامَةِ.","Sonra ararım. Hoşça kal.",["Daha sonra arayacağım. Güle güle.","Sonra ararım. Allah’a emanet ol."]]]],
  ["Otelde",[["أُرِيدُ غُرْفَةً لِلَيْلَتَيْنِ.","İki gecelik bir oda istiyorum.",["İki gece için bir oda istiyorum."]],["هَلْ عِنْدَكَ حَجْزٌ؟","Rezervasyonunuz var mı?",["Rezervasyonun var mı?","Yer ayırttınız mı?"]],["لَا، لَيْسَ عِنْدِي.","Hayır, yok.",["Hayır, rezervasyonum yok."]],["لَا مُشْكِلَةَ، هٰذَا هُوَ الْمِفْتَاحُ.","Sorun değil, işte anahtar.",["Sorun yok, anahtar bu."]]]]
]
