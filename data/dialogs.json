[
  ["Selamlaşma",[["السَّلَامُ عَلَيْكُمْ.","Selamünaleyküm.",["Selam size.","Esselamü aleyküm."]],["وَعَلَيْكُمُ السَّلَامُ.","Aleykümselam.",["Ve aleyküm selam.","Size de selam."]],["كَيْفَ حَالُكَ؟","Nasılsın?",["Nasılsınız?","Hâlin nasıl?"]],["بِخَيْرٍ، الْحَمْدُ لِلّٰهِ. وَأَنْتَ؟","İyiyim, elhamdülillah. Ya sen?",["İyiyim, Allah’a şükür. Ya sen?","İyiyim, çok şükür. Sen nasılsın?"]],["أَنَا بِخَيْرٍ، شُكْرًا.","Ben de iyiyim, teşekkürler.",["İyiyim, teşekkür ederim.","İyiyim, sağ ol."]]]],
  ["Tanışma",[["مَا اسْمُكَ؟","Adın ne?",["Adınız ne?","İsmin ne?"]],["اِسْمِي أَحْمَدُ، وَأَنْتَ؟","Adım Ahmed, ya sen?",["Benim adım Ahmed, ya senin?","İsmim Ahmed, ya sen?"]],["اِسْمِي يُوسُفُ.","Adım Yusuf.",["Benim adım Yusuf.","İsmim Yusuf."]],["مِنْ أَيْنَ أَنْتَ؟","Nerelisin?",["Nerelisiniz?","Sen nerelisin?"]],["أَنَا مِنْ تُرْكِيَا.","Türkiye’denim.",["Ben Türkiye’denim.","Türkiyeliyim."]],["تَشَرَّفْنَا.","Memnun oldum.",["Müşerref oldum.","Tanıştığımıza memnun oldum."]]]],
  ["Aile",[["كَمْ أَخًا عِنْدَكَ؟","Kaç erkek kardeşin var?",["Kaç tane erkek kardeşin var?","Kaç erkek kardeşiniz var?"]],["عِنْدِي أَخَوَانِ وَأُخْتٌ وَاحِدَةٌ.","İki erkek kardeşim ve bir kız kardeşim var.",["İki erkek ve bir kız kardeşim var."]],["أَيْنَ يَسْكُنُونَ؟","Nerede oturuyorlar?",["Nerede yaşıyorlar?"]],["يَسْكُنُونَ فِي إِسْطَنْبُولَ.","İstanbul’da oturuyorlar.",["İstanbul’da yaşıyorlar."]]]],
  ["Okulda",[["هَلْ عِنْدَكَ قَلَمٌ؟","Kalemin var mı?",["Sende kalem var mı?","Kaleminiz var mı?"]],["نَعَمْ، تَفَضَّلْ.","Evet, buyur.",["Evet, buyurun.","Evet, al."]],["مَتَى يَبْدَأُ الدَّرْسُ؟","Ders ne zaman başlıyor?",["Ders ne zaman başlar?"]],["يَبْدَأُ فِي السَّاعَةِ التَّاسِعَةِ.","Saat dokuzda başlıyor.",["Saat dokuzda başlar.","Dokuzda başlıyor."]],["شُكْرًا لَكَ.","Teşekkür ederim.",["Sana teşekkür ederim.","Teşekkürler.","Sağ ol."]]]],
  ["Saat kaç?",[["كَمِ السَّاعَةُ الْآنَ؟","Saat şimdi kaç?",["Şimdi saat kaç?","Saat kaç?"]],["السَّاعَةُ الثَّالِثَةُ وَالنِّصْفُ.","Saat üç buçuk.",["Saat üç otuz."]],["هَلْ تَأَخَّرْنَا؟","Geç mi kaldık?",["Geciktik mi?"]],["لَا، عِنْدَنَا وَقْتٌ.","Hayır, vaktimiz var.",["Hayır, zamanımız var."]]]],
  ["Namaz vakti",[["هَلْ صَلَّيْتَ الظُّهْرَ؟","Öğle namazını kıldın mı?",["Öğleyi kıldın mı?","Öğle namazını kıldınız mı?"]],["لَا، لَمْ أُصَلِّ بَعْدُ.","Hayır, henüz kılmadım.",["Hayır, daha kılmadım."]],["هَيَّا بِنَا نُصَلِّي مَعًا.","Haydi beraber kılalım.",["Haydi birlikte namaz kılalım.","Hadi beraber namaz kılalım."]],["إِنْ شَاءَ اللّٰهُ.","İnşallah.",["Allah dilerse.","Allah izin verirse."]]]],
  ["Yol sorma",[["مِنْ فَضْلِكَ، أَيْنَ الْمَسْجِدُ؟","Affedersin, cami nerede?",["Lütfen, cami nerede?","Affedersiniz, mescit nerede?"]],["اِذْهَبْ مُسْتَقِيمًا ثُمَّ إِلَى الْيَمِينِ.","Düz git, sonra sağa.",["Dümdüz git, sonra sağa dön.","Doğru git, sonra sağa."]],["هَلْ هُوَ بَعِيدٌ؟","Uzak mı?",["Orası uzak mı?"]],["لَا، هُوَ قَرِيبٌ جِدًّا.","Hayır, çok yakın."],["جَزَاكَ اللّٰهُ خَيْرًا.","Allah razı olsun.",["Allah seni hayırla mükâfatlandırsın.","Allah hayrını versin."]]]],
  ["Alışveriş",[["بِكَمْ هٰذَا؟","Bu kaça?",["Bu ne kadar?","Bunun fiyatı ne?"]],["بِعِشْرِينَ رِيَالًا.","Yirmi riyal.",["Yirmi riyale."]],["هٰذَا غَالٍ جِدًّا.","Bu çok pahalı."],["خُذْهُ بِخَمْسَةَ عَشَرَ.","On beşe al.",["Onu on beşe al.","On beş riyale al."]],["حَسَنًا، شُكْرًا.","Tamam, teşekkürler.",["Peki, teşekkürler.","Tamam, sağ ol."]]]],
  ["Lokantada",[["مَاذَا تُرِيدُ أَنْ تَأْكُلَ؟","Ne yemek istersin?",["Ne yemek istiyorsun?","Ne yemek istersiniz?"]],["أُرِيدُ دَجَاجًا وَأَرُزًّا.","Tavuk ve pilav istiyorum.",["Tavuk ve pirinç istiyorum.","Tavuk pilav istiyorum."]],["وَمَاذَا تَشْرَبُ؟","Ne içersin?",["Peki ne içersin?","Ne içersiniz?"]],["كُوبَ شَايٍ، مِنْ فَضْلِكَ.","Bir bardak çay, lütfen.",["Bir fincan çay, lütfen."]],["تَفَضَّلْ.","Buyurun.",["Buyur."]]]],
  ["Doktorda",[["مَاذَا بِكَ؟","Neyin var?",["Sorun ne?","Neyiniz var?"]],["عِنْدِي صُدَاعٌ.","Başım ağrıyor.",["Baş ağrım var."]],["مُنْذُ مَتَى؟","Ne zamandan beri?",["Ne zamandır?"]],["مُنْذُ أَمْسِ.","Dünden beri.",["Dünden bu yana."]],["خُذْ هٰذَا الدَّوَاءَ، شَفَاكَ اللّٰهُ.","Bu ilacı al, Allah şifa versin.",["Bu ilacı al, Allah sana şifa versin.","Bu ilacı alın, Allah şifa versin."]]]],
  ["Telefonda",[["أَلُو، مَنْ يَتَكَلَّمُ؟","Alo, kim konuşuyor?",["Alo, kiminle görüşüyorum?","Alo, kimsiniz?"]],["أَنَا خَالِدٌ. هَلْ مُحَمَّدٌ مَوْجُودٌ؟","Ben Halid. Muhammed orada mı?",["Ben Halid. Muhammed evde mi?","Ben Halid. Muhammed var mı?"]],["لَا، هُوَ لَيْسَ هُنَا الْآنَ.","Hayır, şu an burada değil.",["Hayır, o şu anda burada değil."]],["سَأَتَّصِلُ لَاحِقًا. مَعَ السَّلَامَةِ.","Sonra ararım. Hoşça kal.",["Daha sonra arayacağım. Güle güle.","Sonra ararım. Allah’a emanet ol."]]]],
  ["Otelde",[["أُرِيدُ غُرْفَةً لِلَيْلَتَيْنِ.","İki gecelik bir oda istiyorum.",["İki gece için bir oda istiyorum."]],["هَلْ عِنْدَكَ حَجْزٌ؟","Rezervasyonunuz var mı?",["Rezervasyonun var mı?","Yer ayırttınız mı?"]],["لَا، لَيْسَ عِنْدِي.","Hayır, yok.",["Hayır, rezervasyonum yok."]],["لَا مُشْكِلَةَ، هٰذَا هُوَ الْمِفْتَاحُ.","Sorun değil, işte anahtar.",["Sorun yok, anahtar bu."]]]],
  ["Hava durumu",[["كَيْفَ الطَّقْسُ الْيَوْمَ؟","Bugün hava nasıl?",["Hava bugün nasıl?"]],["الطَّقْسُ حَارٌّ وَمُشْمِسٌ.","Hava sıcak ve güneşli.",["Sıcak ve güneşli bir hava var."]],["هَلْ سَيَنْزِلُ الْمَطَرُ غَدًا؟","Yarın yağmur yağacak mı?",["Yarın yağmur yağar mı?"]],["نَعَمْ، وَسَيَكُونُ الْجَوُّ بَارِدًا.","Evet, hava da soğuk olacak.",["Evet, ayrıca hava soğuk olacak."]],["إِذَنْ سَآخُذُ مِظَلَّتِي وَمِعْطَفِي.","O hâlde şemsiyemi ve montumu alacağım.",["Öyleyse şemsiyemi ve paltomu alırım."]],["فِكْرَةٌ جَيِّدَةٌ!","İyi fikir!",["Güzel fikir!"]]]],
  ["Sabah rutini",[["مَتَى تَسْتَيْقِظُ فِي الصَّبَاحِ؟","Sabah ne zaman uyanırsın?",["Sabahları kaçta kalkıyorsun?","Sabah ne zaman uyanırsınız?"]],["أَسْتَيْقِظُ قَبْلَ الْفَجْرِ.","Şafaktan önce uyanırım.",["Tan ağarmadan kalkarım."]],["وَمَاذَا تَفْعَلُ بَعْدَ ذٰلِكَ؟","Peki sonra ne yaparsın?",["Ondan sonra ne yapıyorsun?"]],["أَتَوَضَّأُ وَأُصَلِّي، ثُمَّ أُنَظِّفُ أَسْنَانِي.","Abdest alır, namaz kılarım, sonra dişlerimi fırçalarım.",["Abdest alıp namaz kılarım, sonra dişlerimi temizlerim."]],["مَتَى تَخْرُجُ مِنَ الْبَيْتِ؟","Evden ne zaman çıkarsın?",["Evden kaçta çıkıyorsun?"]],["أَخْرُجُ فِي السَّاعَةِ السَّابِعَةِ وَالنِّصْفِ.","Saat yedi buçukta çıkarım.",["Yedi buçukta çıkıyorum."]],["أَنْتَ نَشِيطٌ جِدًّا!","Çok dinçsin!",["Ne kadar da enerjiksin!"]]]],
  ["Kahvaltı",[["صَبَاحَ الْخَيْرِ يَا أُمِّي.","Günaydın anneciğim.",["Günaydın anne."]],["صَبَاحَ النُّورِ يَا حَبِيبِي. الْفُطُورُ جَاهِزٌ.","Günaydın canım. Kahvaltı hazır.",["Sana da günaydın yavrum. Kahvaltı hazır."]],["مَاذَا عِنْدَنَا الْيَوْمَ؟","Bugün ne var?",["Bugün kahvaltıda ne var?"]],["خُبْزٌ وَجُبْنٌ وَزَيْتُونٌ وَبَيْضٌ. هَلْ تُرِيدُ شَايًا؟","Ekmek, peynir, zeytin ve yumurta. Çay ister misin?",["Ekmek, peynir, zeytin ve yumurta var. Çay istiyor musun?"]],["لَا، أُرِيدُ حَلِيبًا مِنْ فَضْلِكِ.","Hayır, süt istiyorum lütfen.",["Hayır, lütfen süt ver."]],["تَفَضَّلْ، بِالْهَنَاءِ وَالشِّفَاءِ.","Buyur, afiyet olsun.",["Al bakalım, afiyet olsun."]],["شُكْرًا يَا أُمِّي، الطَّعَامُ لَذِيذٌ.","Teşekkürler anneciğim, yemekler çok lezzetli.",["Sağ ol anne, yemek lezzetli."]]]],
  ["Mutfakta",[["مَاذَا تَطْبُخِينَ يَا جَدَّتِي؟","Ne pişiriyorsun nineciğim?",["Ne yemek yapıyorsun nine?"]],["أَطْبُخُ شُورْبَةَ الْعَدَسِ.","Mercimek çorbası pişiriyorum.",["Mercimek çorbası yapıyorum."]],["هَلْ أُسَاعِدُكِ؟","Sana yardım edeyim mi?",["Yardım edebilir miyim?"]],["نَعَمْ، اِغْسِلِ الْجَزَرَ مِنْ فَضْلِكَ.","Evet, havuçları yıka lütfen.",["Evet, lütfen havuçları yıka."]],["وَبَعْدَ ذٰلِكَ؟","Peki sonra?",["Ondan sonra?"]],["قَطِّعِ الْبَصَلَ بِحَذَرٍ.","Soğanı dikkatlice doğra.",["Soğanı dikkatli kes."]],["رَائِحَةُ الطَّعَامِ طَيِّبَةٌ جِدًّا!","Yemeğin kokusu çok güzel!",["Yemek çok güzel kokuyor!"]],["سَنَأْكُلُ بَعْدَ قَلِيلٍ.","Birazdan yiyeceğiz.",["Az sonra yemek yiyeceğiz."]]]],
  ["Pazarda",[["بِكَمْ كِيلُو الطَّمَاطِمِ؟","Domatesin kilosu kaça?",["Domatesin kilosu ne kadar?"]],["بِعَشَرَةِ رِيَالَاتٍ.","On riyal.",["On riyale."]],["أَعْطِنِي كِيلُوَيْنِ، مِنْ فَضْلِكَ.","İki kilo ver, lütfen.",["Bana iki kilo verin, lütfen."]],["تَفَضَّلْ. هَلْ تُرِيدُ شَيْئًا آخَرَ؟","Buyurun. Başka bir şey ister misiniz?",["Buyur. Başka bir şey istiyor musun?"]],["نَعَمْ، أُرِيدُ تُفَّاحًا وَمَوْزًا.","Evet, elma ve muz istiyorum.",["Evet, biraz elma ve muz istiyorum."]],["التُّفَّاحُ طَازَجٌ الْيَوْمَ.","Elmalar bugün taze.",["Bugün elmalar taze."]],["كَمِ الْمَجْمُوعُ؟","Toplam ne kadar?",["Hepsi ne kadar?"]],["ثَلَاثُونَ رِيَالًا.","Otuz riyal.",["Hepsi otuz riyal."]]]],
  ["Kütüphanede",[["أُرِيدُ أَنْ أَسْتَعِيرَ هٰذَا الْكِتَابَ.","Bu kitabı ödünç almak istiyorum.",["Bu kitabı ödünç alabilir miyim?"]],["هَلْ عِنْدَكَ بِطَاقَةُ الْمَكْتَبَةِ؟","Kütüphane kartın var mı?",["Kütüphane kartınız var mı?"]],["نَعَمْ، هٰذِهِ هِيَ.","Evet, işte bu.",["Evet, buyurun."]],["يُمْكِنُكَ أَنْ تَأْخُذَهُ لِمُدَّةِ أُسْبُوعَيْنِ.","Onu iki haftalığına alabilirsin.",["İki hafta süreyle alabilirsiniz."]],["أَيْنَ كُتُبُ الْأَطْفَالِ؟","Çocuk kitapları nerede?",["Çocuklar için kitaplar nerede?"]],["فِي الطَّابِقِ الثَّانِي. تَكَلَّمْ بِهُدُوءٍ مِنْ فَضْلِكَ.","İkinci katta. Lütfen sessizce konuş.",["İkinci katta. Lütfen alçak sesle konuşun."]],["حَسَنًا، شُكْرًا جَزِيلًا.","Tamam, çok teşekkürler.",["Peki, çok teşekkür ederim."]]]],
  ["Sınıfta ödev",[["هَلْ كَتَبْتُمُ الْوَاجِبَ؟","Ödevi yaptınız mı?",["Ödevinizi yazdınız mı?"]],["نَعَمْ يَا أُسْتَاذُ.","Evet hocam.",["Evet öğretmenim."]],["وَأَنْتَ يَا عُمَرُ، أَيْنَ دَفْتَرُكَ؟","Ya sen Ömer, defterin nerede?",["Peki sen Ömer, defterin nerede?"]],["نَسِيتُهُ فِي الْبَيْتِ، آسِفٌ.","Evde unuttum, özür dilerim.",["Onu evde unuttum, kusura bakmayın."]],["لَا بَأْسَ، أَحْضِرْهُ غَدًا.","Önemli değil, yarın getir.",["Olsun, yarın getirirsin."]],["إِنْ شَاءَ اللّٰهُ يَا أُسْتَاذُ.","İnşallah hocam.",["İnşallah öğretmenim."]],["الْوَاجِبُ الْجَدِيدُ فِي الصَّفْحَةِ الْعِشْرِينَ.","Yeni ödev yirminci sayfada.",["Yeni ödev sayfa yirmide."]],["هَلْ هُوَ صَعْبٌ؟","Zor mu?",["O zor mu?"]],["لَا، هُوَ سَهْلٌ.","Hayır, kolay.",["Hayır, o kolay."]]]],
  ["Sınav sonrası",[["كَيْفَ كَانَ الِامْتِحَانُ؟","Sınav nasıldı?",["Sınav nasıl geçti?"]],["كَانَ سَهْلًا، الْحَمْدُ لِلّٰهِ.","Kolaydı, elhamdülillah.",["Kolaydı, çok şükür."]],["هَلْ أَجَبْتَ عَنْ كُلِّ الْأَسْئِلَةِ؟","Bütün sorulara cevap verdin mi?",["Bütün soruları cevapladın mı?"]],["نَعَمْ، إِلَّا سُؤَالًا وَاحِدًا. وَأَنْتَ؟","Evet, bir soru hariç. Ya sen?",["Evet, biri hariç hepsini. Peki sen?"]],["كَانَ صَعْبًا عَلَيَّ قَلِيلًا.","Benim için biraz zordu.",["Bana biraz zor geldi."]],["لَا تَحْزَنْ، سَتَنْجَحُ إِنْ شَاءَ اللّٰهُ.","Üzülme, inşallah geçersin.",["Üzülme, inşallah başarırsın."]],["شُكْرًا، سَأَدْرُسُ أَكْثَرَ فِي الْمَرَّةِ الْقَادِمَةِ.","Teşekkürler, bir dahaki sefere daha çok çalışacağım.",["Sağ ol, gelecek sefer daha çok ders çalışacağım."]]]],
  ["Arkadaşı davet etme",[["هَلْ أَنْتَ مَشْغُولٌ يَوْمَ الْجُمُعَةِ؟","Cuma günü meşgul müsün?",["Cuma günü işin var mı?"]],["لَا، لَسْتُ مَشْغُولًا. لِمَاذَا؟","Hayır, meşgul değilim. Neden?",["Hayır, boşum. Niye?"]],["أَدْعُوكَ إِلَى الْغَدَاءِ فِي بَيْتِنَا.","Seni evimize öğle yemeğine davet ediyorum.",["Seni bize öğle yemeğine çağırıyorum."]],["شُكْرًا جَزِيلًا! فِي أَيِّ سَاعَةٍ؟","Çok teşekkürler! Saat kaçta?",["Çok sağ ol! Saat kaçta?"]],["بَعْدَ صَلَاةِ الْجُمُعَةِ.","Cuma namazından sonra.",["Cuma namazının ardından."]],["هَلْ أُحْضِرُ شَيْئًا مَعِي؟","Yanımda bir şey getireyim mi?",["Bir şey getireyim mi?"]],["لَا، تَعَالَ فَقَطْ.","Hayır, sen gel yeter.",["Hayır, sadece gel."]],["إِلَى اللِّقَاءِ يَوْمَ الْجُمُعَةِ.","Cuma günü görüşürüz.",["Cumaya görüşmek üzere."]]]],
  ["Doğum günü",[["كُلُّ عَامٍ وَأَنْتِ بِخَيْرٍ يَا سَارَةُ!","İyi ki doğdun Sara!",["Nice yıllara Sara!"]],["شُكْرًا لَكِ يَا مَرْيَمُ.","Teşekkür ederim Meryem.",["Sağ ol Meryem."]],["هٰذِهِ هَدِيَّةٌ صَغِيرَةٌ لَكِ.","Bu senin için küçük bir hediye.",["Sana küçük bir hediye."]],["مَا أَجْمَلَ هٰذَا الْكِتَابَ! شُكْرًا.","Bu kitap ne kadar güzel! Teşekkürler.",["Ne güzel bir kitap! Sağ ol."]],["كَمْ عُمْرُكِ الْيَوْمَ؟","Bugün kaç yaşına girdin?",["Bugün kaç yaşındasın?"]],["عُمْرِي تِسْعُ سَنَوَاتٍ. هَيَّا نَأْكُلُ الْكَعْكَةَ!","Dokuz yaşındayım. Haydi pastayı yiyelim!",["Dokuz yaşına girdim. Hadi pastayı yiyelim!"]],["الْكَعْكَةُ لَذِيذَةٌ جِدًّا!","Pasta çok lezzetli!",["Pasta çok güzel olmuş!"]]]],
  ["Bayram tebriki",[["عِيدٌ مُبَارَكٌ يَا عَمِّي!","Bayramın mübarek olsun amcacığım!",["İyi bayramlar amca!"]],["عِيدٌ مُبَارَكٌ، وَكُلُّ عَامٍ وَأَنْتَ بِخَيْرٍ.","Senin de bayramın mübarek olsun, nice yıllara.",["Bayramın kutlu olsun, nice senelere."]],["تَقَبَّلَ اللّٰهُ مِنَّا وَمِنْكُمْ.","Allah bizden ve sizden kabul etsin.",["Allah ibadetlerimizi kabul etsin."]],["آمِينَ. تَفَضَّلْ، هٰذِهِ عِيدِيَّةٌ لَكَ.","Amin. Buyur, bu senin bayram harçlığın.",["Amin. Al, bu sana bayram harçlığı."]],["شُكْرًا جَزِيلًا يَا عَمِّي!","Çok teşekkürler amcacığım!",["Çok sağ ol amca!"]],["أَيْنَ أَبُوكَ؟","Baban nerede?",["Baban nereye gitti?"]],["ذَهَبَ لِيَزُورَ جَدِّي.","Dedemi ziyarete gitti.",["Dedemi ziyaret etmeye gitti."]],["سَلِّمْ عَلَيْهِ مِنْ فَضْلِكَ.","Lütfen ona selamımı söyle.",["Ona benden selam söyle lütfen."]]]],
  ["Ramazan ve iftar",[["هَلْ أَنْتَ صَائِمٌ الْيَوْمَ؟","Bugün oruçlu musun?",["Bugün oruç tutuyor musun?"]],["نَعَمْ، الْحَمْدُ لِلّٰهِ.","Evet, elhamdülillah.",["Evet, çok şükür."]],["مَتَى أَذَانُ الْمَغْرِبِ؟","Akşam ezanı ne zaman?",["Akşam ezanı kaçta?"]],["بَعْدَ نِصْفِ سَاعَةٍ.","Yarım saat sonra.",["Yarım saate kadar."]],["هَيَّا نُسَاعِدُ أُمَّنَا فِي تَحْضِيرِ الْمَائِدَةِ.","Haydi sofrayı hazırlamakta annemize yardım edelim.",["Hadi annemize sofrayı hazırlamasında yardım edelim."]],["فِكْرَةٌ جَمِيلَةٌ. سَأَضَعُ التَّمْرَ وَالْمَاءَ.","Güzel fikir. Hurmaları ve suyu ben koyarım.",["İyi fikir. Ben hurma ve suyu koyayım."]],["اِسْمَعْ، هٰذَا هُوَ الْأَذَانُ!","Dinle, işte ezan!",["Dinle, ezan okunuyor!"]],["اللّٰهُمَّ لَكَ صُمْتُ وَعَلَى رِزْقِكَ أَفْطَرْتُ.","Allah’ım, senin için oruç tuttum ve senin rızkınla orucumu açtım.",["Allah’ım, senin rızan için oruç tuttum, senin rızkınla iftar ettim."]]]],
  ["Camide",[["أَيْنَ مَكَانُ الْوُضُوءِ؟","Abdesthane nerede?",["Abdest alınacak yer nerede?"]],["هُنَاكَ، عَلَى الْيَسَارِ.","Orada, solda.",["Şurada, sol tarafta."]],["أَيْنَ أَضَعُ حِذَائِي؟","Ayakkabılarımı nereye koyayım?",["Ayakkabımı nereye koyayım?"]],["ضَعْهُ فِي الْخِزَانَةِ عِنْدَ الْبَابِ.","Kapının yanındaki dolaba koy.",["Onları kapının yanındaki dolaba koy."]],["مَتَى تُقَامُ الصَّلَاةُ؟","Namaz ne zaman başlayacak?",["Kamet ne zaman getirilecek?"]],["بَعْدَ خَمْسِ دَقَائِقَ.","Beş dakika sonra.",["Beş dakikaya kadar."]],["هَلْ يُمْكِنُنِي أَنْ أَجْلِسَ فِي الصَّفِّ الْأَوَّلِ؟","İlk safta oturabilir miyim?",["Ön safta oturabilir miyim?"]],["نَعَمْ، تَفَضَّلْ، وَأَغْلِقْ هَاتِفَكَ.","Evet, buyur, telefonunu da kapat.",["Evet, buyurun; telefonunuzu da kapatın."]]]],
  ["Umre hazırlığı",[["مَتَى تُسَافِرُونَ إِلَى مَكَّةَ؟","Mekke’ye ne zaman gidiyorsunuz?",["Mekke’ye ne zaman yolculuk edeceksiniz?"]],["نُسَافِرُ لِلْعُمْرَةِ الْأُسْبُوعَ الْقَادِمَ.","Gelecek hafta umreye gidiyoruz.",["Önümüzdeki hafta umre için yola çıkıyoruz."]],["مَا شَاءَ اللّٰهُ! هَلْ جَهَّزْتُمُ الْحَقَائِبَ؟","Maşallah! Bavulları hazırladınız mı?",["Maşallah! Valizlerinizi hazırladınız mı?"]],["نَعَمْ، وَأَخَذْنَا مَلَابِسَ الْإِحْرَامِ.","Evet, ihram kıyafetlerini de aldık.",["Evet, ihramlarımızı da aldık."]],["وَجَوَازُ السَّفَرِ وَالتَّأْشِيرَةُ؟","Ya pasaport ve vize?",["Pasaportla vize ne durumda?"]],["كُلُّهَا جَاهِزَةٌ، الْحَمْدُ لِلّٰهِ.","Hepsi hazır, elhamdülillah.",["Hepsi hazır, çok şükür."]],["اُدْعُ لَنَا هُنَاكَ.","Orada bize de dua et.",["Orada bizim için dua et."]],["إِنْ شَاءَ اللّٰهُ، لَنْ نَنْسَاكُمْ.","İnşallah, sizi unutmayacağız.",["İnşallah, sizi unutmayız."]]]],
  ["Havalimanında",[["السَّلَامُ عَلَيْكُمْ، هٰذِهِ تَذْكِرَتِي وَجَوَازُ سَفَرِي.","Selamünaleyküm, bu biletim ve pasaportum.",["Selamünaleyküm, biletim ve pasaportum burada."]],["وَعَلَيْكُمُ السَّلَامُ. كَمْ حَقِيبَةً مَعَكَ؟","Aleykümselam. Kaç bavulun var?",["Aleykümselam. Kaç valiziniz var?"]],["حَقِيبَةٌ وَاحِدَةٌ فَقَطْ.","Sadece bir bavul.",["Yalnızca bir valiz."]],["هَلْ تُرِيدُ مَقْعَدًا بِجَانِبِ النَّافِذَةِ؟","Cam kenarında bir koltuk ister misiniz?",["Pencere kenarında bir yer ister misin?"]],["نَعَمْ، مِنْ فَضْلِكَ. مَا رَقْمُ الْبَوَّابَةِ؟","Evet, lütfen. Kapı numarası kaç?",["Evet, lütfen. Hangi kapıdan bineceğim?"]],["الْبَوَّابَةُ رَقْمُ سَبْعَةٍ، وَالطَّائِرَةُ تُقْلِعُ فِي الْعَاشِرَةِ.","Yedi numaralı kapı; uçak saat onda kalkıyor.",["Kapı yedi, uçak onda kalkacak."]],["شُكْرًا جَزِيلًا.","Çok teşekkürler.",["Çok teşekkür ederim."]],["رِحْلَةً سَعِيدَةً!","İyi yolculuklar!",["İyi uçuşlar!"]]]],
  ["Otobüs ve taksi",[["هَلْ تَذْهَبُ هٰذِهِ الْحَافِلَةُ إِلَى الْمَتْحَفِ؟","Bu otobüs müzeye gidiyor mu?",["Bu otobüs müzeye gider mi?"]],["لَا، الْأَفْضَلُ أَنْ تَأْخُذَ سَيَّارَةَ أُجْرَةٍ.","Hayır, taksiye binmen daha iyi olur.",["Hayır, taksi tutsan daha iyi."]],["إِلَى الْمَتْحَفِ، مِنْ فَضْلِكَ.","Müzeye, lütfen.",["Lütfen müzeye gidelim."]],["تَفَضَّلْ، اِرْكَبْ.","Buyurun, binin.",["Buyur, bin."]],["كَمِ الْأُجْرَةُ؟","Ücret ne kadar?",["Ne kadar tutar?"]],["عِشْرُونَ رِيَالًا.","Yirmi riyal.",["Yirmi riyal tutar."]],["كَمْ دَقِيقَةً تَسْتَغْرِقُ الرِّحْلَةُ؟","Yolculuk kaç dakika sürer?",["Kaç dakikada varırız?"]],["حَوَالَيْ رُبْعِ سَاعَةٍ.","Yaklaşık çeyrek saat.",["Aşağı yukarı on beş dakika."]],["قِفْ هُنَا مِنْ فَضْلِكَ، شُكْرًا.","Burada durun lütfen, teşekkürler.",["Lütfen burada dur, sağ ol."]]]],
  ["Tren istasyonunda",[["أُرِيدُ تَذْكِرَةً إِلَى أَنْقَرَةَ.","Ankara’ya bir bilet istiyorum.",["Ankara için bir bilet istiyorum."]],["ذَهَابًا فَقَطْ أَمْ ذَهَابًا وَإِيَابًا؟","Sadece gidiş mi, gidiş-dönüş mü?",["Tek yön mü, gidiş-dönüş mü?"]],["ذَهَابًا وَإِيَابًا، مِنْ فَضْلِكَ.","Gidiş-dönüş, lütfen.",["Lütfen gidiş-dönüş olsun."]],["مَتَى تُرِيدُ أَنْ تُسَافِرَ؟","Ne zaman yolculuk etmek istiyorsunuz?",["Ne zaman gitmek istiyorsun?"]],["غَدًا صَبَاحًا.","Yarın sabah.",["Yarın sabahleyin."]],["هُنَاكَ قِطَارٌ فِي السَّاعَةِ الثَّامِنَةِ.","Saat sekizde bir tren var.",["Sekizde bir tren var."]],["مُمْتَازٌ. مِنْ أَيِّ رَصِيفٍ يَنْطَلِقُ؟","Harika. Hangi perondan kalkıyor?",["Çok iyi. Hangi perondan hareket ediyor?"]],["مِنَ الرَّصِيفِ الثَّالِثِ.","Üçüncü perondan.",["Üç numaralı perondan."]]]],
  ["Bankada",[["أُرِيدُ أَنْ أَفْتَحَ حِسَابًا.","Hesap açmak istiyorum.",["Bir hesap açtırmak istiyorum."]],["هَلْ مَعَكَ بِطَاقَةُ الْهُوِيَّةِ؟","Kimlik kartınız yanınızda mı?",["Kimliğin yanında mı?"]],["نَعَمْ، تَفَضَّلْ.","Evet, buyurun.",["Evet, buyur."]],["اِمْلَأْ هٰذِهِ الِاسْتِمَارَةَ مِنْ فَضْلِكَ.","Lütfen bu formu doldurun.",["Bu formu doldur lütfen."]],["هَلْ أَكْتُبُ عُنْوَانِي هُنَا؟","Adresimi buraya mı yazayım?",["Adresimi buraya yazayım mı?"]],["نَعَمْ، وَوَقِّعْ فِي الْأَسْفَلِ.","Evet, en alta da imza atın.",["Evet, altını da imzala."]],["أَيْنَ أَجِدُ الصَّرَّافَ الْآلِيَّ؟","Bankamatiği nerede bulurum?",["ATM nerede?"]],["عِنْدَ الْمَدْخَلِ.","Girişte.",["Girişin yanında."]]]],
  ["Postanede",[["أُرِيدُ أَنْ أُرْسِلَ هٰذِهِ الرِّسَالَةَ إِلَى تُرْكِيَا.","Bu mektubu Türkiye’ye göndermek istiyorum.",["Bu mektubu Türkiye’ye yollamak istiyorum."]],["بِالْبَرِيدِ الْعَادِيِّ أَمِ السَّرِيعِ؟","Normal postayla mı, hızlı postayla mı?",["Normal mi, ekspres mi?"]],["بِالْبَرِيدِ الْعَادِيِّ. كَمِ الثَّمَنُ؟","Normal postayla. Ücreti ne kadar?",["Normal olsun. Ne kadar tutuyor?"]],["خَمْسَةُ رِيَالَاتٍ.","Beş riyal.",["Beş riyal tutar."]],["وَمَتَى تَصِلُ؟","Peki ne zaman ulaşır?",["Ne zaman varır?"]],["بَعْدَ أُسْبُوعٍ تَقْرِيبًا.","Yaklaşık bir hafta sonra.",["Aşağı yukarı bir haftada."]],["وَأُرِيدُ أَيْضًا أَنْ أُرْسِلَ هٰذَا الطَّرْدَ.","Bir de bu paketi göndermek istiyorum.",["Ayrıca bu koliyi de göndermek istiyorum."]],["ضَعْهُ عَلَى الْمِيزَانِ مِنْ فَضْلِكَ.","Lütfen onu teraziye koyun.",["Onu tartıya koy lütfen."]]]],
  ["Eczanede",[["مَسَاءَ الْخَيْرِ، عِنْدِي زُكَامٌ.","İyi akşamlar, nezle oldum.",["İyi akşamlar, soğuk algınlığım var."]],["هَلْ عِنْدَكَ حُمَّى؟","Ateşin var mı?",["Ateşiniz var mı?"]],["لَا، وَلٰكِنْ عِنْدِي سُعَالٌ.","Hayır, ama öksürüğüm var.",["Hayır, fakat öksürüyorum."]],["خُذْ هٰذَا الشَّرَابَ ثَلَاثَ مَرَّاتٍ فِي الْيَوْمِ.","Bu şurubu günde üç kez iç.",["Bu şuruptan günde üç defa alın."]],["قَبْلَ الْأَكْلِ أَمْ بَعْدَهُ؟","Yemekten önce mi, sonra mı?",["Yemekten önce mi yoksa sonra mı?"]],["بَعْدَ الْأَكْلِ. وَاشْرَبْ مَاءً كَثِيرًا.","Yemekten sonra. Bir de bol su iç.",["Yemekten sonra. Bol su da için."]],["كَمْ ثَمَنُهُ؟","Fiyatı ne kadar?",["Ne kadar?"]],["اِثْنَا عَشَرَ رِيَالًا. شَفَاكَ اللّٰهُ.","On iki riyal. Allah şifa versin.",["On iki riyal. Geçmiş olsun."]]]],
  ["Kayboldum",[["مِنْ فَضْلِكَ يَا شُرْطِيُّ، سَاعِدْنِي!","Lütfen polis amca, bana yardım edin!",["Polis bey, lütfen bana yardım edin!"]],["لَا تَخَفْ. مَا اسْمُكَ؟","Korkma. Adın ne?",["Korkma. İsmin ne?"]],["اِسْمِي عَلِيٌّ. أَضَعْتُ أَبِي فِي السُّوقِ.","Adım Ali. Babamı çarşıda kaybettim.",["Benim adım Ali. Pazarda babamı kaybettim."]],["هَلْ تَعْرِفُ رَقْمَ هَاتِفِهِ؟","Onun telefon numarasını biliyor musun?",["Babanın telefon numarasını biliyor musun?"]],["نَعَمْ، أَحْفَظُهُ.","Evet, ezbere biliyorum.",["Evet, ezberimde."]],["جَيِّدٌ، سَأَتَّصِلُ بِهِ الْآنَ.","Güzel, onu şimdi arayacağım.",["Aferin, hemen onu arıyorum."]],["شُكْرًا لَكَ.","Teşekkür ederim.",["Sağ olun."]],["أَبُوكَ قَادِمٌ، اِنْتَظِرْ هُنَا مَعِي.","Baban geliyor, burada benimle bekle.",["Baban yolda, benimle burada bekle."]]]],
  ["Spor ve yürüyüş",[["هَلْ تُمَارِسُ الرِّيَاضَةَ؟","Spor yapar mısın?",["Spor yapıyor musun?"]],["نَعَمْ، أَمْشِي كُلَّ يَوْمٍ نِصْفَ سَاعَةٍ.","Evet, her gün yarım saat yürürüm.",["Evet, her gün yarım saat yürüyüş yaparım."]],["أَيْنَ تَمْشِي؟","Nerede yürüyorsun?",["Nerede yürüyüş yapıyorsun?"]],["فِي الْحَدِيقَةِ قُرْبَ بَيْتِي.","Evimin yakınındaki parkta.",["Evime yakın olan parkta."]],["أَنَا أَلْعَبُ كُرَةَ الْقَدَمِ مَعَ أَصْدِقَائِي.","Ben arkadaşlarımla futbol oynarım.",["Ben de arkadaşlarımla futbol oynuyorum."]],["الرِّيَاضَةُ مُفِيدَةٌ لِلصِّحَّةِ.","Spor sağlığa faydalıdır.",["Spor sağlık için yararlıdır."]],["هَلْ يُمْكِنُنِي أَنْ أَمْشِيَ مَعَكَ غَدًا؟","Yarın seninle yürüyebilir miyim?",["Yarın seninle yürüyüşe çıkabilir miyim?"]],["بِكُلِّ سُرُورٍ!","Seve seve!",["Memnuniyetle!"]]]],
  ["Hobiler",[["مَا هِوَايَتُكَ؟","Hobin ne?",["Hobin nedir?","Hobiniz ne?"]],["أُحِبُّ الرَّسْمَ كَثِيرًا.","Resim yapmayı çok severim.",["Resim çizmeyi çok seviyorum."]],["مَاذَا تَرْسُمُ؟","Ne çizersin?",["Neler çiziyorsun?"]],["أَرْسُمُ الطُّيُورَ وَالْأَشْجَارَ. وَأَنْتَ؟","Kuşları ve ağaçları çizerim. Ya sen?",["Kuş ve ağaç resimleri yaparım. Peki sen?"]],["أَنَا أُحِبُّ الْقِرَاءَةَ وَجَمْعَ الطَّوَابِعِ.","Ben okumayı ve pul toplamayı severim.",["Ben kitap okumayı ve pul biriktirmeyi seviyorum."]],["كَمْ طَابِعًا عِنْدَكَ؟","Kaç pulun var?",["Kaç tane pulun var?"]],["عِنْدِي أَكْثَرُ مِنْ مِئَتَيْ طَابِعٍ.","İki yüzden fazla pulum var.",["İki yüzü aşkın pulum var."]],["مَا شَاءَ اللّٰهُ! أُرِيدُ أَنْ أَرَاهَا.","Maşallah! Onları görmek istiyorum.",["Maşallah! Onları görmek isterim."]]]],
  ["Hafta sonu planı",[["مَاذَا سَتَفْعَلُ فِي نِهَايَةِ الْأُسْبُوعِ؟","Hafta sonu ne yapacaksın?",["Hafta sonu ne yapacaksınız?"]],["سَأَزُورُ جَدِّي وَجَدَّتِي فِي الْقَرْيَةِ.","Köyde dedemi ve ninemi ziyaret edeceğim.",["Köye, dedemle nineme gideceğim."]],["جَمِيلٌ! كَمْ يَوْمًا سَتَبْقَى هُنَاكَ؟","Ne güzel! Orada kaç gün kalacaksın?",["Güzel! Kaç gün kalacaksın orada?"]],["يَوْمَيْنِ فَقَطْ. وَأَنْتَ؟","Sadece iki gün. Ya sen?",["Yalnızca iki gün. Peki sen?"]],["سَنَذْهَبُ إِلَى شَاطِئِ الْبَحْرِ إِنْ كَانَ الْجَوُّ جَمِيلًا.","Hava güzel olursa deniz kenarına gideceğiz.",["Hava güzelse sahile gideceğiz."]],["وَإِنْ نَزَلَ الْمَطَرُ؟","Ya yağmur yağarsa?",["Peki yağmur yağarsa?"]],["سَنَبْقَى فِي الْبَيْتِ وَنَلْعَبُ الشِّطْرَنْجَ.","Evde kalıp satranç oynayacağız.",["Evde kalır, satranç oynarız."]],["أَتَمَنَّى لَكَ عُطْلَةً سَعِيدَةً!","Sana iyi tatiller dilerim!",["İyi tatiller!"]]]],
  ["Yeni ev",[["هَلِ انْتَقَلْتُمْ إِلَى بَيْتٍ جَدِيدٍ؟","Yeni bir eve mi taşındınız?",["Yeni bir eve taşındınız mı?"]],["نَعَمْ، الْبَيْتُ الْجَدِيدُ أَكْبَرُ مِنَ الْقَدِيمِ.","Evet, yeni ev eskisinden daha büyük.",["Evet, yeni evimiz eskisinden büyük."]],["كَمْ غُرْفَةً فِيهِ؟","Kaç odası var?",["İçinde kaç oda var?"]],["فِيهِ ثَلَاثُ غُرَفٍ وَمَطْبَخٌ وَحَمَّامَانِ.","Üç oda, bir mutfak ve iki banyo var.",["Üç odası, bir mutfağı ve iki banyosu var."]],["وَهَلْ عِنْدَكَ غُرْفَةٌ خَاصَّةٌ بِكَ؟","Peki kendine ait bir odan var mı?",["Kendi odan var mı?"]],["نَعَمْ، غُرْفَتِي صَغِيرَةٌ وَلٰكِنَّهَا جَمِيلَةٌ.","Evet, odam küçük ama güzel.",["Evet, odam küçük fakat güzel."]],["مَاذَا فِيهَا؟","İçinde neler var?",["Odanda ne var?"]],["فِيهَا سَرِيرٌ وَمَكْتَبٌ وَنَافِذَةٌ كَبِيرَةٌ.","İçinde bir yatak, bir çalışma masası ve büyük bir pencere var.",["Bir yatak, bir masa ve büyük bir pencere var."]],["أُرِيدُ أَنْ أَزُورَكَ قَرِيبًا.","Yakında seni ziyaret etmek istiyorum.",["Yakında sana gelmek isterim."]]]],
  ["Komşuyla sohbet",[["صَبَاحَ الْخَيْرِ يَا جَارِي.","Günaydın komşum.",["Günaydın komşu."]],["صَبَاحَ النُّورِ. كَيْفَ حَالُ الْعَائِلَةِ؟","Günaydın. Ailen nasıl?",["Sana da günaydın. Aile nasıl?"]],["الْحَمْدُ لِلّٰهِ، كُلُّهُمْ بِخَيْرٍ.","Elhamdülillah, hepsi iyi.",["Çok şükür, hepsi iyi."]],["سَمِعْتُ أَنَّ ابْنَكَ كَانَ مَرِيضًا.","Oğlunun hasta olduğunu duydum.",["Oğlun hastaymış, duydum."]],["نَعَمْ، وَلٰكِنَّهُ تَحَسَّنَ الْآنَ.","Evet, ama şimdi iyileşti.",["Evet, fakat şimdi daha iyi."]],["الْحَمْدُ لِلّٰهِ عَلَى سَلَامَتِهِ. إِذَا احْتَجْتُمْ شَيْئًا فَأَخْبِرُونِي.","Allah’a şükür iyileşmiş. Bir şeye ihtiyacınız olursa bana söyleyin.",["Geçmiş olsun, çok şükür. Bir ihtiyacınız olursa haber verin."]],["جَزَاكَ اللّٰهُ خَيْرًا، أَنْتَ جَارٌ طَيِّبٌ.","Allah razı olsun, sen iyi bir komşusun.",["Allah hayrını versin, çok iyi bir komşusun."]]]],
  ["İş görüşmesi",[["تَفَضَّلْ بِالْجُلُوسِ.","Buyurun, oturun.",["Lütfen oturun."]],["شُكْرًا جَزِيلًا.","Çok teşekkürler.",["Çok teşekkür ederim."]],["عَرِّفْنَا بِنَفْسِكَ مِنْ فَضْلِكَ.","Lütfen kendinizi tanıtın.",["Bize kendinizden bahseder misiniz?"]],["اِسْمِي حَسَنٌ، وَعُمْرِي خَمْسٌ وَعِشْرُونَ سَنَةً.","Adım Hasan, yirmi beş yaşındayım.",["Benim adım Hasan ve yirmi beş yaşındayım."]],["مَا خِبْرَتُكَ فِي هٰذَا الْعَمَلِ؟","Bu işte deneyiminiz nedir?",["Bu iş için tecrübeniz ne?"]],["عَمِلْتُ مُعَلِّمًا لِمُدَّةِ ثَلَاثِ سَنَوَاتٍ.","Üç yıl öğretmen olarak çalıştım.",["Üç sene öğretmenlik yaptım."]],["لِمَاذَا تُرِيدُ هٰذِهِ الْوَظِيفَةَ؟","Bu işi neden istiyorsunuz?",["Bu işi neden istiyorsun?"]],["لِأَنَّنِي أُحِبُّ الْعَمَلَ مَعَ الْأَطْفَالِ.","Çünkü çocuklarla çalışmayı seviyorum.",["Çocuklarla çalışmayı sevdiğim için."]],["مُمْتَازٌ، سَنَتَّصِلُ بِكَ قَرِيبًا.","Harika, yakında sizi arayacağız.",["Çok iyi, sizinle yakında iletişime geçeceğiz."]],["شُكْرًا عَلَى وَقْتِكُمْ.","Zaman ayırdığınız için teşekkürler.",["Vaktiniz için teşekkür ederim."]]]],
  ["Vedalaşma ve teşekkür",[["غَدًا أَرْجِعُ إِلَى تُرْكِيَا.","Yarın Türkiye’ye dönüyorum.",["Yarın Türkiye’ye geri dönüyorum."]],["سَنَشْتَاقُ إِلَيْكَ كَثِيرًا.","Seni çok özleyeceğiz.",["Seni çok arayacağız."]],["وَأَنَا أَيْضًا. شُكْرًا عَلَى كُلِّ شَيْءٍ.","Ben de. Her şey için teşekkürler.",["Ben de sizi özleyeceğim. Her şey için sağ olun."]],["لَا شُكْرَ عَلَى وَاجِبٍ.","Lafı bile olmaz.",["Teşekküre gerek yok, görevimizdi."]],["تَعَلَّمْتُ مِنْكُمْ أَشْيَاءَ كَثِيرَةً.","Sizden çok şey öğrendim.",["Sizden pek çok şey öğrendim."]],["زُرْنَا مَرَّةً أُخْرَى إِنْ شَاءَ اللّٰهُ.","İnşallah bizi yine ziyaret et.",["İnşallah yine bize gel."]],["إِنْ شَاءَ اللّٰهُ. سَأَتَّصِلُ بِكُمْ.","İnşallah. Sizi arayacağım.",["İnşallah. Sizi ararım."]],["فِي أَمَانِ اللّٰهِ.","Allah’a emanet ol.",["Allah’a emanet."]],["مَعَ السَّلَامَةِ.","Hoşça kalın.",["Güle güle.","Elveda."]]]]
]
